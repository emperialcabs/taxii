{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/Taxigo.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Taxigo.apk\""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Taxigo.apk",
      "destination": "https://github.com/emperialcabs/taxii/raw/main/Taxigo.apk",
      "permanent": false
    },
    {
      "source": "/taxigo.apk",
      "destination": "https://github.com/emperialcabs/taxii/raw/main/Taxigo.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!assets/|api/|.*\\.apk$|.*\\.zip$|.*\\.png$|.*\\.jpg$|.*\\.jpeg$|.*\\.svg$|.*\\.ico$|.*\\.gif$|.*\\.webp$|.*\\.woff2?$|.*\\.ttf$|.*\\.css$|.*\\.js$|.*\\.json$|.*\\.map$).*)",
      "destination": "/index.html"
    }
  ]
}
